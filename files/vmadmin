<script nonce="__NONCE__">
"use strict";
var PW = sessionStorage.getItem("vmadminpw") || "";
var statusTimer = null;

function hdr(extra){ var h = {"Authorization": "Basic " + btoa("admin:" + PW)}; if (extra) { for (var k in extra) { h[k] = extra[k]; } } return h; }
async function api(path, opts){
  opts = opts || {};
  opts.headers = hdr(opts.headers);
  var r = await fetch(path, opts);
  if (r.status === 401){ showLogin("Login fehlgeschlagen"); throw new Error("401"); }
  if (r.status === 429){ showLogin("Gesperrt: zu viele Fehlversuche (Retry-After " + r.headers.get("Retry-After") + " s)"); throw new Error("429"); }
  if (r.status === 503){ toast("Verwaltung deaktiviert (kein Admin-Passwort gesetzt)"); throw new Error("503"); }
  if (!r.ok){ var t = await r.text(); toast("Fehler " + r.status + ": " + t.slice(0, 200)); throw new Error(String(r.status)); }
  return r.json();
}
function esc(s){ return String(s).replace(/[&<>"']/g, function(c){ return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]; }); }
function toast(msg){
  var t = document.getElementById("toast");
  t.textContent = msg;
  t.classList.add("show");
  setTimeout(function(){ t.classList.remove("show"); }, 2600);
}
function fmtBytes(n){
  if (n === null || n === undefined){ return "-"; }
  var u = ["B", "KiB", "MiB", "GiB"], i = 0, v = Number(n);
  while (v >= 1024 && i < u.length - 1){ v /= 1024; i++; }
  return (i ? v.toFixed(1) : v) + " " + u[i];
}
function fmtUptime(s){
  var d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
  return (d ? d + " d " : "") + h + " h " + m + " min";
}
var dlgConfirm = document.getElementById("dlg-confirm");
function showConfirm(title, text){
  return new Promise(function(res){
    document.getElementById("dlg-confirm-title").textContent = title;
    document.getElementById("dlg-confirm-text").textContent = text;
    var yes = document.getElementById("dlg-confirm-yes");
    var no = document.getElementById("dlg-confirm-no");
    function done(v){ dlgConfirm.close(); yes.removeEventListener("click", ok); no.removeEventListener("click", cancel); res(v); }
    function ok(){ done(true); }
    function cancel(){ done(false); }
    yes.addEventListener("click", ok);
    no.addEventListener("click", cancel);
    dlgConfirm.showModal();
  });
}
var PAGES = ["login", "status", "einstellungen", "dienste"];
function showPage(name){
  if (name === "logout"){ logout(); return; }
  PAGES.forEach(function(p){
    var el = document.getElementById("page-" + p);
    if (el){ el.classList.toggle("active", p === name); }
  });
  document.querySelectorAll("nav button").forEach(function(b){
    b.classList.toggle("active", b.dataset.page === name);
  });
  if (location.hash !== "#" + name){ location.hash = "#" + name; }
  if (statusTimer){ clearInterval(statusTimer); statusTimer = null; }
  if (name === "status"){ refreshStatus(); if (document.getElementById("auto").checked){ statusTimer = setInterval(refreshStatus, 5000); } }
  if (name === "dienste"){ refreshJournal(); }
}
function pageFromHash(){
  var h = location.hash.replace("#", "");
  return PAGES.indexOf(h) > 0 ? h : "status";
}
function showLogin(msg){
  PAGES.forEach(function(p){ document.getElementById("page-" + p).classList.toggle("active", p === "login"); });
  if (msg){ document.getElementById("loginmsg").textContent = msg; }
}
async function tryLogin(pw, fromSession){
  PW = pw;
  try {
    await api("/admin/api/state");
    sessionStorage.setItem("vmadminpw", PW);
    document.getElementById("mode").textContent = "angemeldet (admin)";
    showPage(pageFromHash());
    return true;
  } catch (e){
    if (fromSession){
      PW = "";
      sessionStorage.removeItem("vmadminpw");
    }
    return false;
  }
}
async function doLogin(){ return tryLogin(document.getElementById("pw").value, false); }
function logout(){
  sessionStorage.removeItem("vmadminpw");
  location.hash = "";
  location.reload();
}
async function refreshStatus(){
  var d;
  try { d = await api("/admin/api/state"); } catch (e){ return; }
  document.getElementById("st-host").textContent = d.hostname;
  document.getElementById("st-uptime").textContent = fmtUptime(d.uptime_s);
  document.getElementById("st-load").textContent = (d.load || []).join(" / ") || "-";
  document.getElementById("st-kernel").textContent = d.kernel;
  var ramPct = d.ram_total ? Math.min(100, Math.round((d.ram_total - d.ram_avail) * 100 / d.ram_total)) : 0;
  document.getElementById("st-rambar").style.width = ramPct + "%";
  document.getElementById("st-ram").textContent = fmtBytes(d.ram_total - d.ram_avail) + " von " + fmtBytes(d.ram_total) + " belegt (" + ramPct + " %)";
  var diskPct = d.disk_total ? Math.min(100, Math.round(d.disk_used * 100 / d.disk_total)) : 0;
  document.getElementById("st-diskbar").style.width = diskPct + "%";
  document.getElementById("st-disk").textContent = fmtBytes(d.disk_used) + " von " + fmtBytes(d.disk_total) + " belegt (" + diskPct + " %)";
  document.getElementById("st-agent").textContent = d.agent;
  document.getElementById("st-ttyd").textContent = d.ttyd;
