TOKEN_FILE = os.path.join(CONF_DIR, "worker-token")
ENDPOINT_FILE = os.path.join(CONF_DIR, "endpoint")
ADMIN_HASH_FILE = os.path.join(CONF_DIR, "admin-hash")
AGENT_SERVICE = "agent-sandbox-agent"
TTYD_SERVICE = "ttyd-worker"
TTYD_PORT = 7681
# session cookie (for the /terminal iframe, which cannot send an Authorization header):
# browsers only attach cached basic-auth credentials after a WWW-Authenticate challenge, which
# we deliberately never send (round 14); a same-origin session cookie is sent automatically.
SESSION_COOKIE = "vmadmin_session"
SESSION_TTL = 12 * 3600
SESSIONS = {}  # token -> expiry (epoch); guarded by SESSIONS_LOCK
SESSIONS_LOCK = threading.Lock()
HISTORY_FILE = os.path.join(CONF_DIR, "history.jsonl")
HISTORY_SHOWN = 200
MAX_BODY = 1024 * 1024  # 1 MiB Request-Body-Deckel (sonst 413)
UPDATE_REPO = "Ramb0N05/agent-sandbox-relay"
UPDATE_FILES = ["files/agent-sandbox-agent", "files/vmadmin",
                "files/agent-sandbox-agent.service", "files/vm-admin.service"]

# lockout per client IP like the relay: 5 failures -> 300 s, doubling up to 3600 s
LOCK_FAILS = 5
LOCK_BASE = 300
LOCK_MAX = 3600
_locks = {}
_locks_guard = threading.Lock()


def sha256_hex(text):
    return hashlib.sha256(text.encode()).hexdigest()


def stored_admin_hash():
    try:
        with open(ADMIN_HASH_FILE, encoding="utf-8") as f:
            h = f.read().strip()
        return h if re.fullmatch(r"[0-9a-f]{64}", h) else None
    except OSError:
        return None


def validate_token(tok):
    # worker token: ASCII, no whitespace, 8-128 chars (the relay issues 32-byte urlsafe)
    return isinstance(tok, str) and tok.isascii() and 8 <= len(tok) <= 128 \
        and tok == tok.strip() and not any(c.isspace() for c in tok)


def validate_endpoint(ep):
    # relay endpoint: https URL, ASCII, no whitespace, 8-200 chars, host required
    # (21st round: vm-install.sh --domain optional, the endpoint lands here instead)
    if not (isinstance(ep, str) and ep.isascii() and 8 <= len(ep) <= 200
            and ep == ep.strip() and not any(c.isspace() for c in ep)):
        return False
    if not ep.startswith("https://") or len(ep) <= len("https://"):
        return False
    return urlsplit(ep).hostname is not None


def validate_admin_pw(pw):
    # own login password: 8-128 chars, printable (spaces allowed)
    return isinstance(pw, str) and 8 <= len(pw) <= 128 \
        and all(0x20 <= ord(c) <= 0x7E for c in pw) and pw == pw.strip()


def write_atomic(path, content, mode=0o600):
    # atomic: tmp in the same directory, then rename (no half-written state)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _http_get(url):
    r = run(["curl", "-fsSL", "--max-time", "30", url])
    return r.stdout if r.returncode == 0 else None


def run_vm_update(domain=None):
    # Update laeuft vollstaendig in der VM: Dateien vom oeffentlichen Repo holen
    # (Branch-HEAD -> Commit-SHA, raw@<sha> ist immutable; Branch-Refs sind am CDN
    # gecacht), Agent-Platzhalter bei domain ersetzen, sudo install, daemon-reload,
    # Agent-Restart; vm-admin-Restart wird DETACHED (systemd-run --on-active) geplant,
    # damit die HTTP-Antwort nicht abbricht (sonst curl (52) Empty reply).
    sha = _http_get("https://api.github.com/repos/%s/commits/worker" % UPDATE_REPO)
    m = re.search(r'"sha":\s*"([0-9a-f]{40})"', sha or "")
    base = "https://raw.githubusercontent.com/%s/%s" % (UPDATE_REPO, m.group(1) if m else "worker")
    os.makedirs("/tmp/vm-update", exist_ok=True)
    for f in UPDATE_FILES:
        data = _http_get("%s/%s" % (base, f))
        if data is None:
            return False, "Download fehlgeschlagen: %s (base %s)" % (f, base)
        name = f.split("/")[-1]
        src = os.path.join("/tmp/vm-update", name)
        with open(src, "w", encoding="utf-8") as fh:
            fh.write(data)
        os.chmod(src, 0o600)
    if domain:
        src = "/tmp/vm-update/agent-sandbox-agent"
        with open(src, encoding="utf-8") as fh:
            agent = fh.read()
        if "<agent-sandbox-relay-domain>" in agent:
            with open(src, "w", encoding="utf-8") as fh:
                fh.write(agent.replace("<agent-sandbox-relay-domain>", domain))
    installs = [
        ("/tmp/vm-update/agent-sandbox-agent", "/usr/local/bin/agent-sandbox-agent", "worker", "0700"),
        ("/tmp/vm-update/vmadmin", "/usr/local/bin/vmadmin", "worker", "0700"),
        ("/tmp/vm-update/agent-sandbox-agent.service", "/etc/systemd/system/agent-sandbox-agent.service", "root", "0644"),
        ("/tmp/vm-update/vm-admin.service", "/etc/systemd/system/vm-admin.service", "root", "0644"),
    ]
    for src, target, owner, mode in installs:
        r = run(["install", "-o", owner, "-g", owner, "-m", mode, src, target], sudo=True)
        if r.returncode != 0:
            return False, "install %s fehlgeschlagen: %s" % (target, r.stderr.strip())
    run(["systemctl", "daemon-reload"], sudo=True)
    run(["systemctl", "restart", AGENT_SERVICE + ".service"], sudo=True)
    # vm-admin-Restart detached planen - ein synchroner Restart killt die laufende
    # HTTP-Verbindung vor der Antwort (curl (52) Empty reply)
    run(["systemd-run", "--on-active=2s", "systemctl", "restart", "vm-admin.service"], sudo=True)
    return True, "ok (base %s)" % base


def run(cmd_argv, sudo=False):
    argv = (["sudo"] if sudo else []) + cmd_argv
    return subprocess.run(argv, capture_output=True, text=True, timeout=30)


def read_proc_uptime():
    with open("/proc/uptime", encoding="ascii") as f:
        return int(float(f.read().split()[0]))


def read_state():
    mem_total = mem_avail = None
    try:
        with open("/proc/meminfo", encoding="ascii") as f:
            for ln in f:
                if ln.startswith("MemTotal:"):
                    mem_total = int(ln.split()[1]) * 1024
                elif ln.startswith("MemAvailable:"):
                    mem_avail = int(ln.split()[1]) * 1024
    except OSError:
        pass
    loads = []
    try:
        with open("/proc/loadavg", encoding="ascii") as f:
            loads = [float(x) for x in f.read().split()[:3]]
    except (OSError, ValueError):
        pass
    disk = shutil.disk_usage("/")
    tok_mask = None
    try:
        with open(TOKEN_FILE, encoding="utf-8") as f:
            t = f.read().strip()
        if t:
            tok_mask = {"laenge": len(t), "ende": t[-4:] if len(t) >= 4 else t}
    except OSError:
        pass
    endpoint = None
    try:
        with open(ENDPOINT_FILE, encoding="utf-8") as f:
            e = f.read().strip()
        if e:
            endpoint = e
    except OSError:
        pass
    agent = run(["systemctl", "is-active", AGENT_SERVICE])
    ttyd = run(["systemctl", "is-active", TTYD_SERVICE])
    vm_admin = run(["systemctl", "is-active", "vm-admin.service"])
    sysr = run(["systemctl", "is-system-running"])
    boot_id = None
    try:
        with open("/proc/sys/kernel/random/boot_id", encoding="ascii") as f:
            boot_id = f.read().strip()
    except OSError:
        pass
    ci = run(["cloud-init", "status"])
    return {
        "hostname": os.uname().nodename,
        "kernel": os.uname().release,
        "uptime_s": read_proc_uptime(),
        "boot_id": boot_id,
        "cloud_init": ci.stdout.strip() or ("error rc=%d" % ci.returncode if ci.returncode else "unbekannt"),
        "system_running": sysr.stdout.strip() or "unbekannt",
        "load": loads,
        "ram_total": mem_total, "ram_avail": mem_avail,
        "disk_total": disk.total, "disk_used": disk.total - disk.free,
        "agent": agent.stdout.strip() or "unbekannt",
        "vm_admin": vm_admin.stdout.strip() or "unbekannt",
        "ttyd": ttyd.stdout.strip() or "unbekannt",
        "token_mask": tok_mask,
        "endpoint": endpoint,
    }


def _lock_state(peer):
    rec = _locks.get(peer)
    if not rec:
        rec = _locks[peer] = [0, 0]
    return rec


def register_fail(peer):
    with _locks_guard:
        fails, until = _lock_state(peer)
        fails += 1
        if fails >= LOCK_FAILS:
            until = time.time() + min(LOCK_BASE * (2 ** (fails - LOCK_FAILS)), LOCK_MAX)
        _locks[peer] = [fails, until]
    return fails, until


def lockout_remaining(peer):
    with _locks_guard:
        _, until = _lock_state(peer)
        return max(0, until - time.time())


def clear_fails(peer):
    with _locks_guard:
        _locks.pop(peer, None)


def session_token_from_headers(headers):
    c = SimpleCookie()
    try:
        c.load(headers.get("Cookie") or "")
    except Exception:
        return None
    m = c.get(SESSION_COOKIE)
    return m.value if m else None


def session_valid(token):
    if not token:
        return False
    now = time.time()
    with SESSIONS_LOCK:
        exp = SESSIONS.get(token)
        if exp is None:
            return False
        if exp < now:
            del SESSIONS[token]
            return False
        return True


def create_session():
    token = secrets.token_urlsafe(24)
    with SESSIONS_LOCK:
        # alte Sessions desselben Alters begrenzen
        if len(SESSIONS) > 64:
            for k in [k for k, v in SESSIONS.items() if v < time.time()]:
                del SESSIONS[k]
        SESSIONS[token] = time.time() + SESSION_TTL
    return token


def drop_session(token):
    with SESSIONS_LOCK:
        SESSIONS.pop(token, None)


def check_admin(auth_header, peer):
    # returns None on success, else (status_code, headers)
    rem = lockout_remaining(peer)
    if rem > 0:
        return 429, {"Retry-After": str(int(rem) + 1)}
    stored = stored_admin_hash()
    if stored is None:
        return 503, {}
    ok = False
    if auth_header:
        m = re.fullmatch(r"Basic ([A-Za-z0-9+/=]+)", auth_header)
        if m:
            try:
                user, _, pw = base64.b64decode(m.group(1)).decode("utf-8", "replace").partition(":")
                ok = secrets.compare_digest(user.encode(), ADMIN_USERNAME.encode()) \
                    and secrets.compare_digest(sha256_hex(pw).encode(), stored.encode())
            except Exception:
                ok = False
    if not ok:
        register_fail(peer)
        time.sleep(0.5)
        # 401 without WWW-Authenticate: see round 14 (native browser login dialogs)
        return 401, {}
    clear_fails(peer)
    return None, {}


