class Handler(BaseHTTPRequestHandler):
    server_version = "vmadmin"

    def log_message(self, fmt, *args):
        pass  # no access log in journal

    def _peer(self):
        return self.client_address[0] if self.client_address else "?"

    def _send(self, code, body=b"", ctype="application/json", extra=None):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Frame-Options", "SAMEORIGIN")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if body:
            self.wfile.write(body)

    def _send_json(self, code, obj, extra=None):
        self._send(code, json.dumps(obj, ensure_ascii=True), "application/json", extra)

    def _admin_page(self):
        nonce = secrets.token_urlsafe(16)
        html = HTML.replace("__NONCE__", nonce)
        csp = ("default-src 'none'; script-src 'nonce-" + nonce + "'; style-src 'unsafe-inline'; "
               "connect-src 'self'; frame-src 'self'; base-uri 'none'; frame-ancestors 'none'")
        self._send(200, html, "text/html; charset=utf-8", {"Content-Security-Policy": csp})

    def _authed(self):
        # session cookie first (iframe /terminal/ cannot send Authorization), then header
        if session_valid(session_token_from_headers(self.headers)):
            return True
        code, headers = check_admin(self.headers.get("Authorization"), self._peer())
        if code is not None:
            self._send_json(code, {"error": "nicht angemeldet" if code == 401 else "gesperrt"}, headers)
            return False
        return True

    def _proxy_terminal(self):
        # ttyd lauscht nur auf 127.0.0.1:TTYD_PORT (ttyd -i 127.0.0.1) - erreichbar
        # ausschliesslich ueber diesen Proxy, der das vmadmin-Login verlangt.
        # ttyd laeuft mit -b /terminal (base-path), d.h. index /terminal/ und
        # websocket /terminal/ws (ttyd.1); der Proxy reicht /terminal/* 1:1 durch
        # (HTTP komplett, WS nach dem 101-Head bidirektional raw).
        if not self._authed():
            return
        is_ws = "websocket" in (self.headers.get("Upgrade") or "").lower()
        try:
            up = socket.create_connection(("127.0.0.1", TTYD_PORT), timeout=10)
        except OSError:
            self._send_json(502, {"error": "ttyd nicht erreichbar (127.0.0.1:%d) - ttyd-worker aktiv?" % TTYD_PORT})
            return
        req_lines = ["GET %s HTTP/1.1" % self.path, "Host: 127.0.0.1:%d" % TTYD_PORT]
        for k, v in self.headers.items():
            lk = k.lower()
            if lk in ("host", "content-length"):
                continue
            if lk == "connection":
                v = "Upgrade" if is_ws else "close"
            req_lines.append("%s: %s" % (k, v))
        up.sendall(("\r\n".join(req_lines) + "\r\n\r\n").encode("utf-8"))
        self.close_connection = True
        if not is_ws:
            try:
                while True:
                    d = up.recv(65536)
                    if not d:
                        break
                    self.connection.sendall(d)
            except OSError:
                pass
            finally:
                up.close()
            return
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = up.recv(4096)
            if not chunk:
                up.close()
                self._send_json(502, {"error": "ttyd antwortet nicht auf WS-Upgrade"})
                return
            head += chunk
        head_part, _, rest = head.partition(b"\r\n\r\n")
        self.connection.sendall(head_part + b"\r\n\r\n")

        def relay(src, dst, seed=b""):
            try:
                if seed:
                    dst.sendall(seed)
                while True:
                    d = src.read1(65536) if hasattr(src, "read1") else src.recv(65536)
                    if not d:
                        break
                    dst.sendall(d)
            except OSError:
                pass
            finally:
                try:
                    dst.shutdown(socket.SHUT_WR)
                except OSError:
                    pass

        t = threading.Thread(target=relay, args=(up, self.connection, rest), daemon=True)
        t.start()
        relay(self.rfile, up)  # blockiert bis der Client trennt
        try:
            up.close()
        except OSError:
            pass

    def do_GET(self):
        if self.path == "/terminal" or self.path.startswith("/terminal/"):
            self._proxy_terminal()
            return
        if self.path == "/admin":
            self._admin_page()
            return
        if self.path.startswith("/admin/api/"):
            if not self._authed():
                return
            if self.path == "/admin/api/history":
                entries = []
                try:
                    with open(HISTORY_FILE, encoding="utf-8") as f:
                        lines = f.readlines()
                    for ln in lines[-HISTORY_SHOWN:]:
                        try:
                            entries.append(json.loads(ln))
                        except ValueError:
                            pass
                except OSError:
                    pass
                self._send_json(200, {"entries": entries})
                return
            if self.path == "/admin/api/state":
                try:
                    self._send_json(200, read_state())
                except Exception as e:
                    self._send_json(500, {"error": str(e)})
                return
            if self.path.startswith("/admin/api/journal"):
                q = dict(pp.split("=", 1) for pp in urlsplit(self.path).query.split("&") if "=" in pp)
                unit = q.get("unit", AGENT_SERVICE + ".service")
                if not re.fullmatch(r"[A-Za-z0-9_.-]+(\.service)?", unit):
                    self._send_json(422, {"error": "ungueltige Unit"}); return
                r = run(["journalctl", "-n", "30", "-u", unit, "--no-pager", "-o", "short"], sudo=True)
                self._send_json(200 if r.returncode == 0 else 500,
                                {"log": r.stdout if r.returncode == 0 else r.stderr.strip()})
                return
            self._send_json(404, {"error": "unbekannter Endpunkt"})
            return
        self._send(404, b'{"error": "nur /admin"}')

    def _body_json(self):
        try:
            n = int(self.headers.get("Content-Length", "0"))
            if n > MAX_BODY:
                self._send_json(413, {"error": "Body zu gross (>1 MiB)"})
                self.close_connection = True
                return None
            return json.loads(self.rfile.read(n).decode("utf-8")) if n else {}
        except (ValueError, UnicodeDecodeError):
            return None

    def do_POST(self):
        if not self.path.startswith("/admin/api/"):
            self._send(404, b'{"error": "nur /admin/api"}')
            return
        if self.path == "/admin/api/login":
            # password in the body (the browser cannot send a challenge-based header here);
            # sets the session cookie so the /terminal iframe is authenticated too
            data = self._body_json()
            peer = self._peer()
            rem = lockout_remaining(peer)
            if rem > 0:
                self._send_json(429, {"error": "gesperrt"}, {"Retry-After": str(int(rem) + 1)})
                return
            stored = stored_admin_hash()
            pw = data.get("password") if isinstance(data, dict) else None
            ok = stored is not None and isinstance(pw, str) \
                and secrets.compare_digest(sha256_hex(pw).encode(), stored.encode())
            if not ok:
                register_fail(peer)
                time.sleep(0.5)
                self._send_json(401, {"error": "falsches Passwort"})  # no WWW-Authenticate (round 14)
                return
            clear_fails(peer)
            token = create_session()
            self._send_json(200, {"ok": True}, {
                "Set-Cookie": "%s=%s; Path=/; HttpOnly; SameSite=Lax; Max-Age=%d"
                              % (SESSION_COOKIE, token, SESSION_TTL)})
            return
        if self.path == "/admin/api/logout":
            tok = session_token_from_headers(self.headers)
            if tok:
                drop_session(tok)
            self._send_json(200, {"ok": True}, {
                "Set-Cookie": "%s=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0" % SESSION_COOKIE})
            return
        if not self._authed():
            return
        data = self._body_json()
        if data is None:
            return  # 413/ungueltig wurde schon beantwortet
        if not isinstance(data, dict):
            self._send_json(400, {"error": "JSON-Body fehlt"})
            return
        try:
            if self.path == "/admin/api/token" and "token" in data:
                if not validate_token(data["token"]):
                    self._send_json(422, {"error": "Token ungültig (8-128 ASCII-Zeichen, ohne Whitespace)"})
                    return
                write_atomic(TOKEN_FILE, data["token"] + "\n")
                r = run(["systemctl", "restart", AGENT_SERVICE], sudo=True)
                self._send_json(200 if r.returncode == 0 else 500,
                                {"ok": r.returncode == 0, "restart": r.stdout.strip() or r.stderr.strip() or "ok"})
                return
            if self.path == "/admin/api/endpoint" and "endpoint" in data:
                if not validate_endpoint(data["endpoint"]):
                    self._send_json(422, {"error": "Endpoint ungültig (https://-URL, 8-200 ASCII-Zeichen, ohne Whitespace)"})
                    return
                write_atomic(ENDPOINT_FILE, data["endpoint"] + "\n")
                r = run(["systemctl", "restart", AGENT_SERVICE], sudo=True)
                self._send_json(200 if r.returncode == 0 else 500,
                                {"ok": r.returncode == 0, "restart": r.stdout.strip() or r.stderr.strip() or "ok"})
                return
            if self.path == "/admin/api/password" and "old" in data and "new" in data:
                stored = stored_admin_hash()
                if not stored or not secrets.compare_digest(sha256_hex(data["old"]).encode(), stored.encode()):
                    self._send_json(403, {"error": "aktuelles Passwort falsch"})
                    return
                if not validate_admin_pw(data["new"]):
                    self._send_json(422, {"error": "neues Passwort ungültig (8-128 druckbare Zeichen)"})
                    return
                write_atomic(ADMIN_HASH_FILE, sha256_hex(data["new"]) + "\n")
                self._send_json(200, {"ok": True})
                return
            if self.path == "/admin/api/update":
                # Update-Routine komplett in der VM (run_vm_update); Body nur
                # optional {"domain": "..."} - klein, kein Datei-Payload mehr.
                domain = data.get("domain") if isinstance(data, dict) else None
                if domain is not None and not validate_endpoint(domain):
                    self._send_json(422, {"error": "domain ungueltig (https-URL)"}); return
                ok, detail = run_vm_update(domain or None)
                self._send_json(200 if ok else 500, {"ok": ok, "detail": detail})
                return
            if self.path == "/admin/api/service" and "unit" in data:
                unit = data["unit"]
                if unit not in (AGENT_SERVICE, TTYD_SERVICE):
                    self._send_json(422, {"error": "unit nicht erlaubt"})
                    return
                r = run(["systemctl", "restart", unit], sudo=True)
                self._send_json(200 if r.returncode == 0 else 500, {"ok": r.returncode == 0, "unit": unit})
                return
            self._send_json(422, {"error": "unbekannter Endpunkt oder Feld"})
        except Exception as e:
            self._send_json(500, {"error": str(e)})


def main():
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
