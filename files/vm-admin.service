[Unit]
Description=vibe-sandbox VM-Verwaltung (Port 80, nur Host-Zugriff)
After=network.target

[Service]
User=vibe
ExecStart=/usr/local/bin/vmadmin
Restart=always
RestartSec=5
# port 80 without root: AmbientCapabilities passes CAP_NET_BIND_SERVICE to the
# process, CapabilityBoundingSet cuts everything else off (minimal exposure).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
