#!/usr/bin/env bash
# Transportoption E: Pull-Agent gegen die Job-Queue (Docker-Service agent-sandbox-relay) auf dem Hetzner-Server (Abschnitt 10.5)
# Installationsziel in der VM: /usr/local/bin/agent-sandbox-agent, owner vibe:vibe, 0700
# (provisioniert normalerweise per cloud-init, siehe cloud-init/vibe-sandbox-user-data.yaml)
set -u
TOKEN="<agent-sandbox-relay-token>"
ENDPOINT="https://<agent-sandbox-relay-domain>"
OUTMAX=4194304
CMAX=900
while true; do
  resp=$(curl -sS --max-time 310 -H "Authorization: Bearer $TOKEN" "$ENDPOINT/jobs/next" 2>/dev/null || true)
  if [ -n "$resp" ]; then
    id=$(jq -r '.id // empty' <<< "$resp")
    cmd=$(jq -r '.cmd // empty' <<< "$resp")
    if [ -n "$id" ] && [ -n "$cmd" ]; then
      out=$(timeout $CMAX bash -lc "$cmd" 2>&1); rc=$?
      printf '%s' "$out" | head -c $OUTMAX > /tmp/agent-sandbox-out
      jq -n --arg id "$id" --arg rc "$rc" --rawfile out /tmp/agent-sandbox-out \
        '{id:$id, rc:($rc|tonumber), output:$out}' \
      | curl -sS --max-time 60 -H "Authorization: Bearer $TOKEN" \
          -H "Content-Type: application/json" --data-binary @- \
          "$ENDPOINT/jobs/$id/result" >/dev/null || true
      rm -f /tmp/agent-sandbox-out
    fi
  fi
  sleep 1
done
