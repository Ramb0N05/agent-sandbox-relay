#!/usr/bin/env python3
# vmadmin - admin UI of the sandbox-worker VM on port 80 (host access only; NAT without DNAT)
# style like the relay admin UI (relay/templates/admin.html): dark theme, login card with
# sessionStorage, hash navigation, native <dialog> modals, CSP nonce, 401 without challenge
# (round 14: basic challenges trigger native browser login dialogs).
# Python stdlib only (http.server), no packages - provisioned via cloud-init.
# sources: AmbientCapabilities=CAP_NET_BIND_SERVICE (systemd.exec, port < 1024 without root),
# ttyd -c user:password (no credential file, hence the colon ban),
# Python http.server (BaseHTTPRequestHandler/ThreadingHTTPServer).
import base64
import hashlib
import json
import os
import re
import secrets
import shutil
import subprocess
import tempfile
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

PORT = 80
ADMIN_USERNAME = "admin"
CONF_DIR = os.path.join(os.path.expanduser("~"), ".config", "agent-sandbox")
TOKEN_FILE = os.path.join(CONF_DIR, "worker-token")
ENDPOINT_FILE = os.path.join(CONF_DIR, "endpoint")
ADMIN_HASH_FILE = os.path.join(CONF_DIR, "admin-hash")
TTYD_UNIT_PATH = "/etc/systemd/system/ttyd-worker.service"
AGENT_SERVICE = "agent-sandbox-agent"
TTYD_SERVICE = "ttyd-worker"

# lockout per client IP like the relay: 5 failures -> 300 s, doubling up to 3600 s
LOCK_FAILS = 5
LOCK_BASE = 300
LOCK_MAX = 3600
_locks = {}
_locks_guard = threading.Lock()


def sha256_hex(text):
    return hashlib.sha256(text.encode()).hexdigest()


def stored_admin_hash():
    try:
        with open(ADMIN_HASH_FILE, encoding="utf-8") as f:
            h = f.read().strip()
        return h if re.fullmatch(r"[0-9a-f]{64}", h) else None
    except OSError:
        return None


def validate_token(tok):
    # worker token: ASCII, no whitespace, 8-128 chars (the relay issues 32-byte urlsafe)
    return isinstance(tok, str) and tok.isascii() and 8 <= len(tok) <= 128 \
        and tok == tok.strip() and not any(c.isspace() for c in tok)


def validate_endpoint(ep):
    # relay endpoint: https URL, ASCII, no whitespace, 8-200 chars, host required
    # (21st round: vm-install.sh --domain optional, the endpoint lands here instead)
    if not (isinstance(ep, str) and ep.isascii() and 8 <= len(ep) <= 200
            and ep == ep.strip() and not any(c.isspace() for c in ep)):
        return False
    if not ep.startswith("https://") or len(ep) <= len("https://"):
        return False
    return urlsplit(ep).hostname is not None


def validate_ttyd_pw(pw):
    # ttyd only supports -c user:password (no credential file): ':' not allowed;
    # printable ASCII without whitespace, otherwise the ExecStart line breaks
    return isinstance(pw, str) and pw.isascii() and 1 <= len(pw) <= 64 \
        and ":" not in pw and not any(c.isspace() for c in pw) \
        and all(0x21 <= ord(c) <= 0x7E for c in pw)


def validate_admin_pw(pw):
    # own login password: 8-128 chars, printable (spaces allowed)
    return isinstance(pw, str) and 8 <= len(pw) <= 128 \
        and all(0x20 <= ord(c) <= 0x7E for c in pw) and pw == pw.strip()


def write_atomic(path, content, mode=0o600):
    # atomic: tmp in the same directory, then rename (no half-written state)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def ttyd_unit_content(pw):
    # password stays in ExecStart plaintext (ttyd has no credential file; ps-readable -
    # documented weakness as in the assessment; the VM has only the user worker)
    return (
        "[Unit]\n"
        "Description=ttyd Web-Terminal (Transportoption F, nur Host-Zugriff)\n"
        "After=network.target\n\n"
        "[Service]\n"
        "User=worker\n"
        "ExecStart=/usr/bin/ttyd -W -t enableZmodem=true -c worker:" + pw + " -m 2 -w /home/worker bash -l\n"
        "Restart=on-failure\n\n"
        "[Install]\n"
        "WantedBy=multi-user.target\n"
    )


def run(cmd_argv, sudo=False):
    argv = (["sudo"] if sudo else []) + cmd_argv
    return subprocess.run(argv, capture_output=True, text=True, timeout=30)


def read_proc_uptime():
    with open("/proc/uptime", encoding="ascii") as f:
        return int(float(f.read().split()[0]))


def read_state():
    mem_total = mem_avail = None
    try:
        with open("/proc/meminfo", encoding="ascii") as f:
            for ln in f:
                if ln.startswith("MemTotal:"):
                    mem_total = int(ln.split()[1]) * 1024
                elif ln.startswith("MemAvailable:"):
                    mem_avail = int(ln.split()[1]) * 1024
    except OSError:
        pass
    loads = []
    try:
        with open("/proc/loadavg", encoding="ascii") as f:
            loads = [float(x) for x in f.read().split()[:3]]
    except (OSError, ValueError):
        pass
    disk = shutil.disk_usage("/")
    tok_mask = None
    try:
        with open(TOKEN_FILE, encoding="utf-8") as f:
            t = f.read().strip()
        if t:
            tok_mask = {"laenge": len(t), "ende": t[-4:] if len(t) >= 4 else t}
    except OSError:
        pass
    endpoint = None
    try:
        with open(ENDPOINT_FILE, encoding="utf-8") as f:
            e = f.read().strip()
        if e:
            endpoint = e
    except OSError:
        pass
    agent = run(["systemctl", "is-active", AGENT_SERVICE])
    ttyd = run(["systemctl", "is-active", TTYD_SERVICE])
    return {
        "hostname": os.uname().nodename,
        "kernel": os.uname().release,
        "uptime_s": read_proc_uptime(),
        "load": loads,
        "ram_total": mem_total, "ram_avail": mem_avail,
        "disk_total": disk.total, "disk_used": disk.total - disk.free,
        "agent": agent.stdout.strip() or "unbekannt",
        "ttyd": ttyd.stdout.strip() or "unbekannt",
        "token_mask": tok_mask,
        "endpoint": endpoint,
    }


def _lock_state(peer):
    rec = _locks.get(peer)
    if not rec:
        rec = _locks[peer] = [0, 0]
    return rec


def register_fail(peer):
    with _locks_guard:
        fails, until = _lock_state(peer)
        fails += 1
        if fails >= LOCK_FAILS:
            until = time.time() + min(LOCK_BASE * (2 ** (fails - LOCK_FAILS)), LOCK_MAX)
        _locks[peer] = [fails, until]
    return fails, until


def lockout_remaining(peer):
    with _locks_guard:
        _, until = _lock_state(peer)
        return max(0, until - time.time())


def clear_fails(peer):
    with _locks_guard:
        _locks.pop(peer, None)


def check_admin(auth_header, peer):
    # returns None on success, else (status_code, headers)
    rem = lockout_remaining(peer)
    if rem > 0:
        return 429, {"Retry-After": str(int(rem) + 1)}
    stored = stored_admin_hash()
    if stored is None:
        return 503, {}
    ok = False
    if auth_header:
        m = re.fullmatch(r"Basic ([A-Za-z0-9+/=]+)", auth_header)
        if m:
            try:
                user, _, pw = base64.b64decode(m.group(1)).decode("utf-8", "replace").partition(":")
                ok = secrets.compare_digest(user.encode(), ADMIN_USERNAME.encode()) \
                    and secrets.compare_digest(sha256_hex(pw).encode(), stored.encode())
            except Exception:
                ok = False
    if not ok:
        register_fail(peer)
        time.sleep(0.5)
        # 401 without WWW-Authenticate: see round 14 (native browser login dialogs)
        return 401, {}
    clear_fails(peer)
    return None, {}


