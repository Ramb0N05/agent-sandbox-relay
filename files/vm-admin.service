[Unit]
Description=sandbox-worker VM-Verwaltung (Port 80, nur Host-Zugriff)
After=network.target

[Service]
User=worker
ExecStart=/usr/local/bin/vmadmin
Restart=always
RestartSec=5
# port 80 without root: AmbientCapabilities grants CAP_NET_BIND_SERVICE to the
# process. CapabilityBoundingSet is the ceiling for everything the process and its
# children can gain - including via setuid binaries like sudo (systemd.exec(5)):
# sudo needs CAP_SETUID/CAP_SETGID to elevate, install needs CAP_CHOWN/
# CAP_DAC_OVERRIDE/CAP_FOWNER. Without them sudo fails with "unable to change to
# root gid: Operation not permitted" (observed 32nd round).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER

[Install]
WantedBy=multi-user.target
