#!/usr/bin/env python3
# transport option E: pull agent against the job queue (docker service agent-sandbox-relay) on the Hetzner server (section 10.5)
# 11th round: persistent HTTP connection (no curl process per call), no idle sleep
# (the /jobs/next long poll blocks server-side; sleep only on errors).
# install target in the VM: /usr/local/bin/agent-sandbox-agent, owner worker:worker, 0700
# (normally provisioned via cloud-init, see cloud-init/sandbox-worker-user-data.yaml)
import http.client
import json
import os
import ssl
import subprocess
import sys
import time
from urllib.parse import urlsplit

# worker token: file before constant (vmadmin writes /home/worker/.config/agent-sandbox/worker-token,
# then systemctl restart agent-sandbox-agent - the token is only read at startup).
# 21st round: same pattern for the relay endpoint (vmadmin POST endpoint, --domain
# in vm-install.sh optional; without file/parameter the placeholder stays).
TOKEN_FILE = os.environ.get(
    "AGENT_SANDBOX_TOKEN_FILE",
    "/home/worker/.config/agent-sandbox/worker-token",
)
ENDPOINT_FILE = os.environ.get(
    "AGENT_SANDBOX_ENDPOINT_FILE",
    "/home/worker/.config/agent-sandbox/endpoint",
)


def _load_token():
    try:
        with open(TOKEN_FILE, encoding="utf-8") as f:
            t = f.read().strip()
        if t:
            return t
    except OSError:
        pass
    return "<agent-sandbox-relay-worker-token>"


def _load_endpoint():
    try:
        with open(ENDPOINT_FILE, encoding="utf-8") as f:
            e = f.read().strip()
        if e:
            return e
    except OSError:
        pass
    return "https://<agent-sandbox-relay-domain>"


TOKEN = _load_token()
ENDPOINT = _load_endpoint()
HISTORY_FILE = os.path.join(os.path.dirname(ENDPOINT_FILE), "history.jsonl")
HISTORY_MAX = 500  # Zeilen; aelteste werden abgeschnitten
POLL_TIMEOUT = 310  # client cap just above the server-side long poll (300 s)
CMAX = 900  # execution cap per job (seconds)
OUTMAX = 8 * 1024 * 1024  # output cap 8 MiB (section 10.7)
FILEMAX = 8 * 1024 * 1024  # raw size per file in the file store (section 10.8)


class Relay:
    # persistent connection: http.client handles keep-alive, reconnect with one retry
    def __init__(self, endpoint, token, timeout=POLL_TIMEOUT):
        u = urlsplit(endpoint)
        self.host = u.hostname
        self.port = u.port or (443 if u.scheme == "https" else 80)
        self.scheme = u.scheme
        self.path = u.path.rstrip("/")
        self.token = token
        self.timeout = timeout
        self.ctx = ssl.create_default_context() if u.scheme == "https" else None
        self.conn = None

    def _connect(self):
        if self.scheme == "https":
            self.conn = http.client.HTTPSConnection(self.host, self.port, timeout=self.timeout, context=self.ctx)
        else:
            self.conn = http.client.HTTPConnection(self.host, self.port, timeout=self.timeout)

    def _request(self, method, path, body=None, headers=None, retry=True):
        # one attempt over the existing connection; reconnect once on a connection error
        if self.conn is None:
            self._connect()
        h = {"Authorization": "Bearer " + self.token, "User-Agent": "agent-sandbox-agent"}
        if headers:
            h.update(headers)
        try:
            self.conn.request(method, self.path + path, body=body, headers=h)
            resp = self.conn.getresponse()
            data = resp.read()
            return resp.status, data
        except (http.client.HTTPException, OSError):
            try:
                self.conn.close()
            except Exception:
                pass
            self.conn = None
            if retry:
                return self._request(method, path, body=body, headers=headers, retry=False)
            raise

    def next_job(self):
        # {"id": ..., "cmd": ...} or None on 204 (long poll blocks server-side)
        status, data = self._request("GET", "/jobs/next")
        if status == 204:
            return None
        if status != 200:
            raise RuntimeError("jobs/next: HTTP %d" % status)
        j = json.loads(data.decode("utf-8"))
        if not isinstance(j, dict) or not j.get("id") or not j.get("cmd"):
            return None
        return j

    def post_result(self, jid, output, rc):
        body = json.dumps({"id": jid, "rc": int(rc), "output": output}).encode("utf-8")
        status, _ = self._request("POST", "/jobs/%s/result" % jid, body=body,
                                  headers={"Content-Type": "application/json"})
        if status != 200:
            raise RuntimeError("result: HTTP %d" % status)

    def fetch_file(self, fid, target):
        # file from the relay file store into the VM; rc = HTTP status (200 -> 0)
        status, data = self._request("GET", "/files/%s" % fid)
        if status != 200:
            return status
        with open(target, "wb") as f:
            f.write(data)
        return 0

    def send_file(self, path):
        # file from the VM into the relay file store; rc 1 without upload if above FILEMAX
        try:
            with open(path, "rb") as f:
                data = f.read(FILEMAX + 1)
        except OSError:
            return 1, None
        if len(data) > FILEMAX:
            return 1, None
        status, resp = self._request("POST", "/files", body=data,
                                     headers={"Content-Type": "application/octet-stream"})
        if status != 200:
            return status, None
        return 0, json.loads(resp.decode("utf-8"))


def run_cmd(cmd):
    # execution like the bash agent: timeout 900, bash -lc, stdout+stderr combined
    try:
        p = subprocess.run(["timeout", str(CMAX), "bash", "-lc", cmd],
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           timeout=CMAX + 30)
        rc = p.returncode
        out = p.stdout.decode("utf-8", "replace")
    except subprocess.TimeoutExpired as e:
        rc = 124
        out = (e.stdout or b"").decode("utf-8", "replace") if isinstance(e.stdout, bytes) else str(e.stdout or "")
    return rc, out[:OUTMAX]


def execute(cmd, relay):
    # prefixes FETCH (file into the VM) and SEND (file out of the VM), else shell job
    # (21st round: prefix rename; the server treats cmd as opaque)
    if cmd.startswith("FETCH ") and len(cmd.split(" ", 2)) == 3:
        _, fid, target = cmd.split(" ", 2)
        rc = relay.fetch_file(fid, target)
        return rc, "FETCH id=%s target=%s rc=%d" % (fid, target, rc)
    if cmd.startswith("SEND ") and len(cmd.split(" ", 1)) == 2:
        _, path = cmd.split(" ", 1)
        rc, info = relay.send_file(path)
        if rc != 0 or not info:
            return (rc if rc else 1), "SEND fehlgeschlagen rc=%d" % rc
        return 0, "SEND id=%s size=%d" % (info["id"], info["size"])
    return run_cmd(cmd)


def log_history(entry):
    # Verlauf der ausgefuehrten Jobs + Dateiuebertragungen (vmadmin zeigt ihn an)
    try:
        os.makedirs(os.path.dirname(HISTORY_FILE), exist_ok=True)
        with open(HISTORY_FILE, "a", encoding="utf-8") as f:
            f.write(json.dumps(entry, ensure_ascii=True) + "\n")
        # Deckel: letzte HISTORY_MAX Zeilen behalten
        with open(HISTORY_FILE, encoding="utf-8") as f:
            lines = f.readlines()
        if len(lines) > HISTORY_MAX:
            with open(HISTORY_FILE, "w", encoding="utf-8") as f:
                f.writelines(lines[-HISTORY_MAX:])
    except OSError:
        pass


def poll_once(relay):
    # one cycle: long poll, execution, result; None when idle (no sleep needed)
    j = relay.next_job()
    if j is None:
        return None
    rc, out = execute(j["cmd"], relay)
    relay.post_result(j["id"], out, rc)
    cmd = j.get("cmd") or ""
    parts = cmd.split()
    if parts and parts[0] == "FETCH" and len(parts) >= 3:
        entry = {"ts": time.time(), "type": "file", "dir": "in", "id": j["id"],
                 "submitter": j.get("submitter"), "path": parts[2], "rc": rc}
    elif parts and parts[0] == "SEND" and len(parts) >= 2:
        entry = {"ts": time.time(), "type": "file", "dir": "out", "id": j["id"],
                 "submitter": j.get("submitter"), "path": parts[1], "rc": rc}
    else:
        entry = {"ts": time.time(), "type": "job", "id": j["id"],
                 "submitter": j.get("submitter"), "cmd": cmd, "rc": rc, "out_bytes": len(out)}
    log_history(entry)
    return j["id"]


def main():
    if "<" in ENDPOINT:
        # Platzhalter nicht ersetzt: statt [Errno -2] Name or service not known pro Poll
        # einmal klar melden und idlen (die Endpoint-Datei wird nur beim Start gelesen;
        # vmadmin startet den Agent nach dem Setzen des Endpoints neu).
        print("agent-fehler: ENDPOINT ist noch der Platzhalter %r - Relay-Endpoint ueber die "
              "vmadmin-UI setzen (Karte Relay-Endpoint / POST /admin/api/endpoint) oder die Datei "
              "%s beschreiben; der Agent liest sie nur beim Start." % (ENDPOINT, ENDPOINT_FILE),
              file=sys.stderr)
        while True:
            time.sleep(60)
    relay = Relay(ENDPOINT, TOKEN)
    while True:
        try:
            poll_once(relay)
        except Exception as e:
            print("agent-fehler:", e, file=sys.stderr)
            time.sleep(1)  # only on errors; when idle the long poll blocks


if __name__ == "__main__":
    main()
